{
  "name": "animori",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "AniMori — AniList Toolkit. Единая кодовая база для юзерскрипта и десктопного клиента.",
  "license": "MIT",
  "author": "foulnike",
  "scripts": {
    "dev": "vite --mode userscript",
    "build": "tsc --noEmit && vite build --mode userscript",
    "build:userscript": "vite build --mode userscript",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,scss}\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/greasemonkey": "^4.0.7",
    "@types/node": "^26.1.2",
    "prettier": "^3.3.3",
    "sass": "^1.79.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-monkey": "^4.0.6"
  }
}
